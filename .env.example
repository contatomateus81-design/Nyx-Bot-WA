# Your WhatsApp number with country code, digits only (Brazil: 55 + DDD + number)
# Used only to request pairing code. Keep your real .env private.
OWNER_NUMBER=5511999999999

# Optional bot settings
BOT_PREFIX=!
BOT_NAME=Nyx Bot

# Gemini API (obtenha sua chave no Google AI Studio; nunca publique a chave real)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Groq API (mantenha a chave real apenas no arquivo .env privado)
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
