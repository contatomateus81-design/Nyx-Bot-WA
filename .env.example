# Your WhatsApp number with country code, digits only (Brazil: 55 + DDD + number)
# Used only to request pairing code. Keep your real .env private.
OWNER_NUMBER=5511999999999

# Optional bot settings
BOT_PREFIX=!
BOT_NAME=Nyx Bot

# Groq API (obtenha sua api em https://console.groq.com/keys ; nunca publique a chave real)
# Utilize o modelo recomendado pelo readme.md do repositório.
GROQ_API_KEY=SUA-KEY-AQUI
GROQ_MODEL=SEU-MODELO-AQUI
